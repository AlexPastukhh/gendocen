{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DependencyEvent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "recorded_at",
    "event_type",
    "target",
    "receipt_id",
    "status",
    "changed_dependencies",
    "reason_codes"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^event-[0-9a-f]{64}$"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "event_type": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^receipt-[0-9a-f]{64}$"
    },
    "status": {
      "enum": [
        "valid",
        "stale",
        "review_required",
        "build_required",
        "invalid"
      ]
    },
    "changed_dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "state_revision": {
      "type": "integer",
      "minimum": 1
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context_id",
        "decision",
        "reason",
        "actor_kind",
        "evidence",
        "rule_id",
        "rule_revision"
      ],
      "properties": {
        "context_id": {
          "type": "string",
          "pattern": "^reviewctx-[0-9a-f]{64}$"
        },
        "decision": {
          "enum": [
            "still-valid",
            "updated"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "actor_kind": {
          "enum": [
            "human",
            "ai",
            "ci",
            "unknown"
          ]
        },
        "actor_label": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rule_id": {
          "type": "string",
          "minLength": 1
        },
        "rule_revision": {
          "type": "string",
          "minLength": 1
        },
        "prior_receipt_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
