{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SemanticReviewPacket",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "target", "review_context_id", "computed_status", "rule", "target_current",
    "state", "prior_receipt", "dependencies", "changed", "changed_dependencies",
    "reason_codes", "history", "semantic_judgment"
  ],
  "properties": {
    "target": {"type": "string", "minLength": 1},
    "review_context_id": {"type": "string", "pattern": "^reviewctx-[0-9a-f]{64}$"},
    "computed_status": {"enum": ["valid", "stale", "review_required", "invalid"]},
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "target", "dependency_type", "revision", "dependencies"],
      "properties": {
        "rule_id": {"type": "string", "minLength": 1},
        "target": {"type": "string", "minLength": 1},
        "dependency_type": {"enum": ["semantic_review", "compatibility", "validity"]},
        "revision": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "dependencies": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "comparator"],
            "properties": {
              "source": {"type": "string", "minLength": 1},
              "comparator": {"enum": ["exact", "json_structured", "sequence", "set", "text_unified"]}
            }
          }
        }
      }
    },
    "target_current": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "revision", "source_kind", "content"],
      "properties": {
        "ref": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "source_kind": {"enum": ["raw", "derived", "file"]},
        "content": {}
      }
    },
    "state": {"type": ["object", "null"]},
    "prior_receipt": {"type": ["object", "null"]},
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "comparator", "baseline", "current", "changed", "diff"],
        "properties": {
          "source": {"type": "string", "minLength": 1},
          "comparator": {"type": "string", "minLength": 1},
          "baseline": {},
          "current": {},
          "validated_version": {"type": "string"},
          "current_version": {"type": ["string", "null"]},
          "current_source_kind": {"type": "string"},
          "changed": {"type": "boolean"},
          "reason": {"type": "string"},
          "diff": {"type": ["object", "null"]},
          "comparator_changed_from": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "changed": {"type": "boolean"},
    "changed_dependencies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "reason_codes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "history": {"type": "array", "items": {"type": "object"}},
    "semantic_judgment": {"type": "null"}
  }
}
