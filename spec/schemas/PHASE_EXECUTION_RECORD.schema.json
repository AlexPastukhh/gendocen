{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DocumentationEnginePhaseExecutionRecord",
  "type": "object",
  "required": [
    "phase_id",
    "name",
    "status",
    "scope",
    "deliverables",
    "acceptance_axes",
    "acceptance_criteria",
    "pre_execution_questions",
    "emergent_questions",
    "implementation_log",
    "acceptance_summary",
    "axis_reviews"
  ],
  "properties": {
    "phase_id": {
      "type": "string",
      "pattern": "^P[0-9]+$"
    },
    "name": {
      "type": "string"
    },
    "status": {
      "enum": [
        "planned",
        "in_progress",
        "acceptance_review",
        "accepted",
        "blocked"
      ]
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "out_of_scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "deliverables": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "use_cases": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^DOC[0-9]{2}$"
      }
    },
    "acceptance_axes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^DAX[0-9]{2}$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "criterion",
          "axis_ids",
          "status",
          "evidence_refs"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "criterion": {
            "type": "string"
          },
          "axis_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^DAX[0-9]{2}$"
            }
          },
          "status": {
            "enum": [
              "pending",
              "pass",
              "partial",
              "fail",
              "not_applicable"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "pre_execution_questions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/question"
      }
    },
    "emergent_questions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/question"
      }
    },
    "implementation_log": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "entry",
          "evidence_refs"
        ],
        "properties": {
          "entry": {
            "type": "string"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "axis_reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "axis_id",
          "status",
          "evidence_refs"
        ],
        "properties": {
          "axis_id": {
            "type": "string",
            "pattern": "^DAX[0-9]{2}$"
          },
          "status": {
            "enum": [
              "pending",
              "pass",
              "partial",
              "fail",
              "not_tested",
              "not_applicable"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "findings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "acceptance_summary": {
      "type": "object",
      "required": [
        "decision",
        "unresolved_blocking_questions",
        "failed_criteria",
        "notes"
      ],
      "properties": {
        "decision": {
          "enum": [
            "pending",
            "accepted",
            "rejected",
            "blocked"
          ]
        },
        "unresolved_blocking_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "failed_criteria": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "carried_release_gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source_criterion_id",
          "axis_id",
          "target_phase_id",
          "target_criterion_id",
          "status",
          "evidence_refs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source_criterion_id": {
            "type": "string",
            "minLength": 1
          },
          "axis_id": {
            "type": "string",
            "pattern": "^DAX[0-9]{2}$"
          },
          "target_phase_id": {
            "type": "string",
            "pattern": "^P[0-9]+$"
          },
          "target_criterion_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "open",
              "resolved"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "question": {
      "type": "object",
      "required": [
        "id",
        "owner",
        "question",
        "why_it_matters",
        "blocking",
        "recommended_default",
        "status",
        "answer",
        "decision",
        "evidence_refs",
        "acceptance_impact"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "question": {
          "type": "string"
        },
        "why_it_matters": {
          "type": "string"
        },
        "blocking": {
          "type": "boolean"
        },
        "recommended_default": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "pending",
            "answered",
            "deferred"
          ]
        },
        "answer": {
          "type": [
            "string",
            "null"
          ]
        },
        "decision": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "acceptance_impact": {
          "type": "string"
        },
        "owner": {
          "enum": [
            "user",
            "implementer"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "answered"
              }
            }
          },
          "then": {
            "properties": {
              "answer": {
                "type": "string",
                "minLength": 1
              },
              "decision": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    }
  }
}
