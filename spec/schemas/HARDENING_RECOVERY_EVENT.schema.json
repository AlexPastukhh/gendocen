{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Docengine Recovery Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_schema_version",
    "event_id",
    "recovered_at",
    "transaction_id",
    "operation",
    "action",
    "restored_paths",
    "forced",
    "conflict_paths"
  ],
  "properties": {
    "event_schema_version": {
      "const": "1.0.0"
    },
    "event_id": {
      "type": "string",
      "pattern": "^recovery-[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "recovered_at": {
      "type": "string",
      "format": "date-time"
    },
    "transaction_id": {
      "type": "string",
      "pattern": "^txn-[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "operation": {
      "type": [
        "string",
        "null"
      ]
    },
    "action": {
      "const": "rolled_back_interrupted_transaction"
    },
    "restored_paths": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "forced": {
      "type": "boolean"
    },
    "conflict_paths": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  }
}
